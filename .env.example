# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=

# Google Maps
# Maps JavaScript API key for the leagues map
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID with the light and dark styles from src/features/map/styles attached
# Leave empty to use Google's DEMO_MAP_ID with the default style
VITE_GOOGLE_MAPS_MAP_ID=

# =====================================================================================

# Production Only Environment Variables

# Cloudflare
# Cloudflare API token for managing DNS records (required)
CLOUDFLARE_API_TOKEN=
# Cloudflare account ID (required)
CLOUDFLARE_ACCOUNT_ID=

