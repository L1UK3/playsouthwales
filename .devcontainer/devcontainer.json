{
  "name": "playsouthwales",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=playsouthwales-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown node node_modules && npm ci && npm run cf-typegen && ([ -f .env.local ] || cp .env.example .env.local) && npx wrangler d1 migrations apply playsouthwales --local",
  "forwardPorts": [3000, 8976, 4983],
  "portsAttributes": {
    "3000": { "label": "Vite dev", "onAutoForward": "openBrowser" },
    "8976": { "label": "wrangler login callback", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "bradlc.vscode-tailwindcss"]
    }
  }
}
