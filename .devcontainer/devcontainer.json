{
	"name": "Python & Typescript",
	"image": "ghcr.io/prulloac/base:bookworm",
	// Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
		"ghcr.io/devcontainers/features/node:2.1.1": {},
		"ghcr.io/devcontainers/features/python:1.8.0": {
			"version": "3.12"
		},
		"ghcr.io/va-h/devcontainers-features/uv:1": {},
		// Supabase CLI via gh-release: the supabase-cli feature can't filter assets and
		// fails when a release ships both versioned and unversioned tarballs.
		"ghcr.io/devcontainers-extra/features/gh-release:1.0.26": {
			"repo": "supabase/cli",
			"binaryNames": "supabase",
			"version": "latest",
			"releaseTagRegex": "^v2\\.\\d+\\.\\d+$",
			"assetRegex": "^supabase_linux_(amd64|arm64)\\.tar\\.gz$"
		},
		"ghcr.io/devcontainers-extra/features/ruff": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/prettier": {
			"version": "latest"
		}
	},

	"postCreateCommand": "supabase start && docker compose up -d --build",

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		5173,
		5000,
		54321,
		54323
	]

	// Configure tool-specific properties.
	// "customizations": {}
	
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}