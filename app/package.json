{
  "name": "@playsouthwales/app",
  "version": "2.0.0",
  "private": true,
  "description": "The TanStack Start app for playsouthwales, deployed as a Cloudflare Worker",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\" \"src/**/*.test.ts\"",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply playsouthwales --local",
    "db:migrate:remote": "wrangler d1 migrations apply playsouthwales --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed:local": "tsx scripts/seed-d1.ts --local",
    "cf-typegen": "wrangler types"
  }
}
