# Play South Wales - FastAPI Backend Environment Variables Example
# Copy this file to '.env' and fill in your values.

# Clerk Auth Configuration
# Obtain secret key from your Clerk Dashboard (https://clerk.com)
CLERK_SECRET_KEY=sk_test_...

# Optional Clerk Configurations
# CLERK_JWT_KEY=                        # Public key to verify JWTs locally (PEM format)
# CLERK_AUTHORIZED_PARTIES=             # Comma-separated list of allowed origins (defaults: http://localhost:5173, etc.)
# CLERK_WEBHOOK_SIGNING_SECRET=         # Webhook secret to verify webhooks from Clerk

# Supabase Local Configuration
# Set these using the output from running 'npx supabase start' or 'npx supabase status'
# Use the JWT tokens (SERVICE_ROLE_KEY / ANON_KEY starting with 'eyJ...'), NOT the opaque keys ('sb_secret_...' / 'sb_publishable_...')
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=eyJhbGciOi...              # ANON_KEY (starts with eyJ...)
SUPABASE_SECRET_KEY=eyJhbGciOi...       # SERVICE_ROLE_KEY (starts with eyJ...; required by PostgREST)

# Postgres Database URL (used for local connections / migrations)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Allowed CORS Origins (optional, comma-separated list of origins)
# ALLOWED_ORIGINS=http://localhost:5173

# Pokédata API
# POKEDATA_KEY=your_pokedata_api_key_here

# Discord Bot Integration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
