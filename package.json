{
  "name": "playsouthwales",
  "version": "2.0.0",
  "private": true,
  "description": "An interactive, full-stack league scheduling and management application for South Wales leagues",
  "keywords": [
    "tcg",
    "tanstack-start",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/L1UK3/playsouthwales#readme",
  "bugs": {
    "url": "https://github.com/L1UK3/playsouthwales/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L1UK3/playsouthwales.git"
  },
  "author": "Luke Enness",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "main": "index.js",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply playsouthwales --local",
    "db:migrate:remote": "wrangler d1 migrations apply playsouthwales --remote",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "1.7.14",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@vis.gl/react-google-maps": "^1.10.2",
    "drizzle-orm": "^1.0.0-rc.5",
    "lucide-react": "^1.73.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/intent": "0.5.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router-devtools": "1.167.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.70.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
