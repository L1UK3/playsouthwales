{
  "name": "playsouthwales",
  "version": "2.0.0",
  "private": true,
  "description": "An interactive, full-stack league scheduling and management application for South Wales leagues",
  "keywords": [
    "tcg",
    "tanstack-start",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/L1UK3/playsouthwales#readme",
  "bugs": {
    "url": "https://github.com/L1UK3/playsouthwales/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L1UK3/playsouthwales.git"
  },
  "author": "Luke Enness",
  "type": "module",
  "workspaces": [
    "app"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "preview": "npm run preview -w app",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "typecheck": "npm run typecheck -w app",
    "test": "npm run test -w app",
    "deploy": "npm run deploy -w app",
    "db:generate": "npm run db:generate -w app",
    "db:migrate:local": "npm run db:migrate:local -w app",
    "db:migrate:remote": "npm run db:migrate:remote -w app",
    "db:studio": "npm run db:studio -w app",
    "db:seed:local": "npm run db:seed:local -w app",
    "cf-typegen": "npm run cf-typegen -w app"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/intent": "0.5.6"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
