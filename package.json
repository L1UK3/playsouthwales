{
  "name": "playsouthwales",
  "version": "2.0.0",
  "private": true,
  "description": "An interactive, full-stack league scheduling and management application for South Wales leagues",
  "keywords": [
    "tcg",
    "tanstack-start",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/L1UK3/playsouthwales#readme",
  "bugs": {
    "url": "https://github.com/L1UK3/playsouthwales/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L1UK3/playsouthwales.git"
  },
  "author": "Luke Enness",
  "type": "module",
  "workspaces": [
    "app"
  ],
  "imports": {
    "#/*": "./app/src/*"
  },
  "main": "index.js",
  "scripts": {
    "dev": "vite dev app --port 3000",
    "build": "vite build app",
    "preview": "vite preview app",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "typecheck": "tsc --noEmit -p app",
    "test": "tsx --tsconfig app/tsconfig.json --test \"app/tests/**/*.test.ts\" \"app/src/**/*.test.ts\"",
    "deploy": "npm run build && wrangler deploy -c app/dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate --config app/drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply playsouthwales --local -c app/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply playsouthwales --remote -c app/wrangler.jsonc",
    "db:studio": "drizzle-kit studio --config app/drizzle.config.ts",
    "db:seed:local": "tsx app/scripts/seed-d1.ts --local",
    "cf-typegen": "wrangler types -c app/wrangler.jsonc app/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/intent": "0.5.6"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
